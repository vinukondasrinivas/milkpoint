# Copy this file to .env and fill in real values before running the project.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# DB_ENGINE = "postgresql" (default) or "mysql"
DB_ENGINE=postgresql
DB_NAME=dairy_shop
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- If using MySQL instead, use settings like this: ---
# DB_ENGINE=mysql
# DB_NAME=dairy_shop
# DB_USER=root
# DB_PASSWORD=your-mysql-password
# DB_HOST=127.0.0.1
# DB_PORT=3306
